        tsens_apu: thermal-sensor-apu {
                compatible = "generic-adc-thermal";
                #thermal-sensor-cells = <0x0>;
                io-channels = <0x21 0x7>;
                io-channel-names = "sensor-channel";
                phandle = <0x93>;
        };

        tsens_rpu: thermal-sensor-rpu {
                compatible = "generic-adc-thermal";
                #thermal-sensor-cells = <0x0>;
                io-channels = <0x21 0x8>;
                io-channel-names = "sensor-channel";
                phandle = <0x95>;
        };

        tsens_pl: thermal-sensor-pl {
                compatible = "generic-adc-thermal";
                #thermal-sensor-cells = <0x0>;
                io-channels = <0x21 0x14>;
                io-channel-names = "sensor-channel";
                phandle = <0x96>;
        };

        thermal-zones {

                apu-thermal {
                        polling-delay-passive = <0x3e8>;
                        polling-delay = <0x1388>;
                        thermal-sensors = <0x93>;

                        trips {

                                apu_passive: passive {
                                        temperature = <0x16b48>;
                                        hysteresis = <0xdac>;
                                        type = "passive";
                                        phandle = <0x94>;
                                };

                                apu_critical: critical {
                                        temperature = <0x178f4>;
                                        hysteresis = <0xdac>;
                                        type = "critical";
                                        phandle = <0xbe>;
                                };
                        };

                        cooling-maps {

                                map {
                                        trip = <0x94>;
                                        cooling-device = <0x88 0xffffffff 0xffffffff 0x89 0xffffffff 0xffffffff 0x8a 0xffffffff 0xffffffff 0x8b 0xffffffff 0xffffffff>;
                                };
                        };
                };

                rpu-thermal {
                        polling-delay = <0x2710>;
                        thermal-sensors = <0x95>;

                        trips {

                                critical {
                                        temperature = <0x178f4>;
                                        hysteresis = <0xdac>;
                                        type = "critical";
                                };
                        };
                };

                pl-thermal {
                        polling-delay = <0x2710>;
                        thermal-sensors = <0x96>;

                        trips {

                                critical {
                                        temperature = <0x178f4>;
                                        hysteresis = <0xdac>;
                                        type = "critical";
                                };
                        };
                };
        };

